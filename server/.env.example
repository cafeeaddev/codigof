# Copie para server/.env e preencha.

# Porta da API (o Vite faz proxy de /api para cá)
PORT=3001

# Conexão do servidor em runtime. A role e o banco são criados pelo `npm run db:migrate`
# com esta senha — escolha uma qualquer.
DATABASE_URL=postgresql://app_server:TROQUE_ESTA_SENHA@localhost:5432/codigof

# Superusuário do PostgreSQL local (o usuário "postgres" definido na instalação).
# Usado só por db:migrate e db:import.
ADMIN_DATABASE_URL=postgresql://postgres:SENHA_DO_POSTGRES@localhost:5432/postgres

# Banco de produção no Supabase, usado só pelo `npm run db:import`.
# Painel do Supabase > Project Settings > Database > Connection string (Session pooler).
SOURCE_DATABASE_URL=postgresql://postgres.rbjfnuzbrotruqpoermr:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Segredo para assinar os JWTs de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcionais
# OPENAI_API_KEY=        # narração do tutorial (tutorial-narration)
# USERS_API_TOKEN=       # token fixo para a API externa /api/functions/users-api
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin   # se pg_dump/psql não estiverem no PATH
